# 이 양식을 사용자가 관리하는 외부 .env에 복사해 입력한다.
# Django 시작 시 OS 환경변수 FARMCAL_ENV_FILE에 지정된 파일만 자동 로딩한다.
# 경로 설정 예시(가상): $env:FARMCAL_ENV_FILE = 'C:\YOUR_PRIVATE_DIRECTORY\FarmCal\.env'
# FARMCAL_ENV_FILE은 이 파일 안이 아니라 실행 터미널 또는 OS에서 지정한다.
# 기존 OS 환경변수가 파일 값보다 우선한다. 파일은 UTF-8로 저장한다.

# Django 서명 비밀키: 직접 생성한 고유한 긴 임의 문자열. 미설정 시 서버가 시작되지 않는다.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(50))"
# 생성 결과를 아래 항목에 직접 입력한다. 실제 값을 소스·채팅에 공유하지 않는다.
DJANGO_SECRET_KEY=

# KAMIS 발급 인증키와 인증 ID. aT·기상청 인증키와 별도다.
KAMIS_API_KEY=
KAMIS_ID=

# 기상청 단기예보 / 중기예보 서비스의 Decoding 인증키.
# 중기 키는 중기육상·중기기온 조회에 사용한다. 동일하게 발급된 경우에도 각 항목을 채운다.
KMA_API_KEY=
KMA_MID_API_KEY=

# aT API별로 발급받은 Decoding 인증키. 각 서비스의 활용 승인 필요.
AT_REALTIME_API_KEY=
AT_SETTLEMENT_API_KEY=
AT_CODE_API_KEY=

# 아래는 비교 실험용 TimesFM 설정이다. 웹 기본 가격 모델은 로컬 트리 모델을 사용한다.
TIMESFM_BACKEND=gpu
TIMESFM_BATCH_SIZE=8
TIMESFM_CPU_THREADS=4
# 처음 모델을 내려받을 때만 1. 기존 고정 revision의 캐시를 쓰면 0.
TIMESFM_ALLOW_DOWNLOAD=0

