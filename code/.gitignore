# Default deny: publish only reviewed runtime file types and fixed assets.
# Keep directories traversable so specific files can be allowlisted below.
*
!*/
!/.gitignore
!/.gitattributes
!/README.md
!/.env.example
!/manage.py
!/requirements.txt
!/requirements-lock.txt

# Django apps, migrations, and runtime imports.
!/accounts/**/*.py
!/calendar_app/**/*.py
!/chatbot/**/*.py
!/config/**/*.py
!/forecaster/**/*.py
!/weather/**/*.py
!/templates/**/*.html
!/static/**/*.css
!/static/**/*.js
!/static/**/*.otf
!/static/**/*.woff
!/static/**/*.woff2
!/static/**/LICENSE
!/static/vendor/manifest.json

# Fixed service model and its exact public input snapshots.
!/model_artifacts/harvest-tree-20261026-v1/release.json
!/model_artifacts/harvest-tree-20261026-v1/tomato.joblib
!/model_artifacts/harvest-tree-20261026-v1/paprika.joblib
!/data/kamis/tomato_20160101_20261022/snapshot.json
!/data/kamis/paprika_20160101_20261022/snapshot.json
# Official market selector fallback; raw responses and imports stay local.
!/data/markets/paprika_settlement_verified_20261023/codes.json

# Web staff evidence screens read only these aggregate summaries.
!/reports/harvest_20261023_exploratory/summary.json
!/reports/tomato_harvest_20261023_exploratory/summary.json
!/reports/model_comparison_20261023/summary.json
!/reports/model_comparison_extended_20261023/summary.json
!/reports/historical_stability_20261023/summary.json

# Tests, research-only evaluation entry points, tools, local editor settings.
**/tests/
**/test/
**/tests.py
**/test_*.py
**/*_test.py
**/conftest.py
/forecaster/evaluation/
/forecaster/management/commands/evaluate_*.py
/forecaster/management/commands/compare_harvest_models.py
/forecaster/management/commands/check_historical_stability.py
/forecaster/management/commands/train_selected_price_model.py
/forecaster/management/commands/collect_price_snapshot.py
/forecaster/management/commands/audit_market_prices.py
/config/evidence_settings.py
/tools/
/_temp/
/.idea/
/.vscode/
/.claude/
/.codex/
/.agents/

# All Markdown documents except this application's README stay local.
*.[mM][dD]
!/README.md

# Credentials and personal/local state. Only the blank template is shared.
.env
.env.*
*.env
*.env.*
!.env.example
**/secrets/
**/credentials/
**/private/
*secret*.json
*credential*.json
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
.netrc
.npmrc
.pypirc

# Databases, user uploads, backups, archives, logs and crash dumps.
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*
*.sql
*.dump
*.bak
*.backup
*.log
*.log.*
*.zip
*.7z
*.tar
*.gz
*.dmp
**/backups/
**/media/
**/uploads/
**/staticfiles/

# Generated files, virtual environments and dependency caches.
**/__pycache__/
*.py[cod]
**/.venv/
**/venv/
**/env/
**/node_modules/
**/.cache/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/htmlcov/
.coverage*
coverage.xml
*.egg-info/
**/build/
**/dist/
.DS_Store
Thumbs.db
desktop.ini
